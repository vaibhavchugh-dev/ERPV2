# API base URL including /api suffix (no trailing slash after /api)
# Local / phone-on-LAN: use /api (Vite proxies to the API on this PC)
# Production builds: omit or set https://api.v2.cimmple.net/api
# On hosted hostnames, relative /api and localhost are ignored — production API is used.
#
# Phone testing: open http://<PC-LAN-IP>:5174/shop/ (same Wi‑Fi). Do not use
# localhost on the phone — that points at the phone itself.
VITE_API_ROOT=/api
